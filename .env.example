# ─────────────────────────────────────────────────────────────
# Skyline Immigration Portal — Environment Configuration
# Copy this file to ".env" and fill in real values.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
# Public base URL used to build Stripe redirect links (no trailing slash)
APP_URL=http://localhost:3000

# Security — CHANGE THIS to a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret_string

# ─── Stripe (the REAL payment gateway) ───────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Test keys start with sk_test_ / pk_test_  (use Stripe test cards)
# Live keys start with sk_live_ / pk_live_  (process REAL money)
# If left blank, the portal runs in DEMO mode (simulated checkout).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Default currency for charges (ISO 4217)
CURRENCY=usd

# First admin account created on seed (change before going live)
ADMIN_EMAIL=admin@skyline.com
ADMIN_PASSWORD=Skyline@Admin2026

# ─── Email notifications (optional) ──────────────────────────
# When set, the portal emails applicants a confirmation and alerts the
# admin on new applications & contact messages. Leave blank to disable.
# Example (Gmail App Password / SendGrid / Mailgun SMTP):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Skyline <no-reply@skyline.com>
